// Extract incoming parameter options (with fallback defaults) const input = $input.first().json || {}; const projectName = (input.projectName || 'my-boilerplate-app') .toLowerCase() .replace(/[^a-z0-9-_]/g, '-'); const description = input.description || 'Boilerplate generated via n8n workflow'; const author = input.author || 'Developer'; const includeDocker = input.includeDocker === true || input.includeDocker === 'true'; const includeAuth = input.includeAuth === true || input.includeAuth === 'true'; // --------------------------------------------------------------------------- // 1. File Templates // --------------------------------------------------------------------------- const packageJson = { name: projectName, version: '1.0.0', description: description, main: 'src/index.js', scripts: { start: 'node src/index.js', dev: 'nodemon src/index.js' }, author: author, license: 'MIT', dependencies: { express: '^4.19.2', dotenv: '^16.4.5', ...(includeAuth ? { jsonwebtoken: '^9.0.2', bcryptjs: '^2.4.3' } : {}) }, devDependencies: { nodemon: '^3.1.0' } }; const gitignore = `node_modules/ .env *.log .DS_Store dist/ `; const envExample = `PORT=3000 NODE_ENV=development ${includeAuth ? 'JWT_SECRET=your_super_secret_key_here\n' : ''}`; const readme = `# ${projectName} ${description} ## Prerequisites 29/09/2026, 21:20 Building Boilerplate Code n8n Workflows  https://gemini.google.com/app/9d159562fee179c9 2/4  - Node.js >= 18.x - npm or yarn ## Getting Started 1. Install dependencies: \`\`\`bash npm install \`\`\` 2. Configure environment variables: \`\`\`bash cp .env.example .env \`\`\` 3. Start development server: \`\`\`bash npm run dev \`\`\` ${includeDocker ? `## Docker Setup\n\n\`\`\`bash\ndocker build -t ${projectName} .\ndocker run -p 3000:3000 ${projec `; const serverJs = `const express = require('express'); require('dotenv').config(); const app = express(); const PORT = process.env.PORT || 3000; app.use(express.json()); // Health Check Route app.get('/health', (req, res) => { res.json({ status: 'ok', timestamp: new Date() }); }); ${includeAuth ? `// Authentication Route (Placeholder) app.post('/api/auth/login', (req, res) => { const { username, password } = req.body; if (!username || !password) { return res.status(400).json({ error: 'Username and password required' }); } // TODO: Add actual auth check res.json({ message: 'Auth endpoint ready', user: username }); });\n` : ''} app.listen(PORT, () => { console.log(\`Server running on http://localhost:\${PORT}\`); }); `; const dockerfile = `FROM node:20-alpine WORKDIR /usr/src/app COPY package*.json ./ RUN npm ci --only=production COPY . . EXPOSE 3000 CMD ["node", "src/index.js"] `; // --------------------------------------------------------------------------- // 2. Assemble File List // --------------------------------------------------------------------------- const files = [ { fileName: 'package.json', content: JSON.stringify(packageJson, null, 2) }, { fileName: '.gitignore', content: gitignore }, { fileName: '.env.example', content: envExample }, { fileName: 'README.md', content: readme }, { fileName: 'src/index.js', content: serverJs } ]; if (includeDocker) { files.push({ fileName: 'Dockerfile', content: dockerfile }); 29/09/2026, 21:20 Building Boilerplate Code n8n Workflows  https://gemini.google.com/app/9d159562fee179c9 3/4  } // --------------------------------------------------------------------------- // 3. Convert Files to n8n Binary Payload Outputs // --------------------------------------------------------------------------- return files.map((file) => { const base64Data = Buffer.from(file.content, 'utf-8').toString('base64'); return { json: { fileName: file.fileName, projectName: projectName }, binary: { data: { data: base64Data, mimeType: 'text/plain', fileName: file.fileName } } }; });